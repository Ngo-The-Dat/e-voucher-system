@startuml
title Biểu đồ tuần tự: UC-ADM-12 - Xem dashboard quản trị

autonumber
actor "Quản trị viên" as QTV
boundary "Giao diện Dashboard\n(AdminDashboardPage)" as UI
control "DashboardController" as Controller
entity "DashboardService" as Service

== 1. Tải dữ liệu Dashboard tổng quan ==
QTV -> UI : openDashboardPage()
activate UI
UI -> Controller : getDashboardOverview(params)
activate Controller
Controller -> Service : getDashboardOverview(filter)
activate Service

alt A1: Lỗi kết nối cơ sở dữ liệu / hệ thống
    Service --> Controller : throw Error("Database connection error")
    Controller --> UI : 500 InternalServerError
    UI --> QTV : showErrorMessage("Không thể tải dữ liệu", retryButton)
else Truy vấn dữ liệu thành công
    Service --> Controller : return { kpi_stats, efficiency_metrics, category_performance, revenue_chart, recent_orders, top_selling_vouchers }
    Controller --> UI : 200 OK (dashboardOverview)
    UI --> QTV : displayDashboardWidgets(kpis, revenueChart, orderStats)
end
deactivate Service
deactivate Controller

== 2. Lọc số liệu theo khoảng thời gian ==
QTV -> UI : selectTimeRange(today / this_week / this_month / customDate)

alt A2: Khoảng thời gian tùy chọn không hợp lệ (startDate > endDate)
    UI -> UI : validateDateRange(startDate, endDate)
    UI --> QTV : showWarning("Khoảng thời gian không hợp lệ - Ngày bắt đầu phải nhỏ hơn hoặc bằng ngày kết thúc")
else Khoảng thời gian hợp lệ
    UI -> Controller : getDashboardOverview({ period, startDate, endDate })
    activate Controller
    Controller -> Service : getDashboardOverview({ period, startDate, endDate })
    activate Service
    Service --> Controller : return { kpi_stats, efficiency_metrics, category_performance, revenue_chart, recent_orders, top_selling_vouchers }
    deactivate Service
    Controller --> UI : 200 OK (filteredStats)
    deactivate Controller
    UI --> QTV : updateDashboardDisplay(filteredStats)
end
deactivate UI

@enduml
