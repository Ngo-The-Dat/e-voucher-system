@startuml
title Biểu đồ tuần tự: UC-ADM-05 - Khóa/Mở khóa đối tác

autonumber
actor "Quản trị viên" as QTV
boundary "Giao diện Quản lý đối tác\n(ManagePartnersPage)" as UI
control "PartnerController" as Controller
entity "PartnerService" as Service
entity "SystemLogService" as LogService
database "Cơ sở dữ liệu\n(Database)" as DB

== 1. Tải danh sách & Chọn đối tác ==
QTV -> UI : openManagePartnersTab()
activate UI
UI -> Controller : getPartners(page, limit, filter)
activate Controller
Controller -> Service : getPartners(filter)
activate Service
Service -> DB : executeQuery() (SELECT FROM partners)
activate DB
DB --> Service : returnResult
deactivate DB
Service --> Controller : returnPartners(partners)
deactivate Service
Controller --> UI : returnResponse(partnersData)
deactivate Controller

alt A1: Không tìm thấy đối tác phù hợp (partners.length == 0)
    UI --> QTV : showEmptyMessage("Không tìm thấy đối tác phù hợp với bộ lọc")
else Có danh sách đối tác
    UI --> QTV : displayPartnerList(partners)

    == 2. Thao tác Tạm khóa / Mở khóa đối tác ==
    QTV -> UI : selectPartner(partnerId)
    QTV -> UI : clickChangeStatusButton(newStatus)
    UI --> QTV : displayConfirmStatusModal(newStatus)

    alt A2: Quản trị viên hủy thao tác
        QTV -> UI : clickCancelButton()
        UI --> QTV : closeConfirmModal()
    else Quản trị viên xác nhận thao tác
        QTV -> UI : inputReasonAndConfirm(reason)
        UI -> Controller : updatePartnerStatus(partnerId, newStatus, reason)
        activate Controller
        Controller -> Service : updatePartnerStatus(partnerId, newStatus, reason, adminId)
        activate Service

        Service -> DB : executeQuery() (UPDATE partners SET status = $1, lock_reason = $2 WHERE partner_id = $3)
        activate DB
        DB --> Service : returnResult
        deactivate DB

        opt A3: Đối tác bị khóa và đang có voucher công khai
            Service -> DB : executeQuery() (UPDATE vouchers SET status = 'INACTIVE' WHERE partner_id = $1)
            activate DB
            DB --> Service : returnResult (autoHideVouchers)
            deactivate DB
        end

        Service -> LogService : logAdminAction(adminId, action, partnerId, oldValue, newValue)
        activate LogService
        LogService -> DB : executeQuery() (INSERT INTO system_logs)
        activate DB
        DB --> LogService : returnResult
        deactivate DB
        LogService --> Service : returnLogged
        deactivate LogService

        Service --> Controller : returnUpdatedPartner(partner)
        Controller --> UI : returnResponse(partner)
        deactivate Service
        deactivate Controller
        UI --> QTV : showSuccessToast("Cập nhật trạng thái đối tác thành công")
    end
end
deactivate UI

@enduml
