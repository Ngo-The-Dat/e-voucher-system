@startuml
title Biểu đồ tuần tự: UC-ADM-14 - Duyệt hồ sơ nhân viên đối tác

autonumber
actor "Quản trị viên" as QTV
boundary "Giao diện Duyệt nhân viên\n(EmployeeApprovalsPage)" as UI
control "EmployeeApprovalController" as Controller
entity "EmployeeApprovalService" as Service
entity "SystemLogService" as LogService
database "Cơ sở dữ liệu\n(Database)" as DB

== 1. Tải danh sách hồ sơ nhân viên chờ duyệt ==
QTV -> UI : openEmployeeApprovalsTab()
activate UI
UI -> Controller : getPendingEmployeeApprovals(page, limit, filter)
activate Controller
Controller -> Service : getPendingEmployeeApprovals(filter)
activate Service
Service -> DB : executeQuery() (SELECT FROM partner_employees WHERE status = 'PENDING')
activate DB
DB --> Service : returnResult
deactivate DB
Service --> Controller : returnPendingEmployees(employees)
deactivate Service
Controller --> UI : returnResponse(employeesData)
deactivate Controller

alt A1: Không có hồ sơ chờ duyệt (employees.length == 0)
    UI --> QTV : showEmptyMessage("Không có hồ sơ chờ duyệt")
else Có hồ sơ nhân viên chờ duyệt (employees.length > 0)
    UI --> QTV : displayPendingEmployeeList(employees)

    == 2. Xem chi tiết hồ sơ nhân viên ==
    QTV -> UI : selectEmployeeDetail(approvalId)
    UI -> Controller : getPendingEmployeeDetail(approvalId)
    activate Controller
    Controller -> Service : getPendingEmployeeDetail(approvalId)
    activate Service
    Service -> DB : executeQuery()
    activate DB
    DB --> Service : returnResult
    deactivate DB
    Service --> Controller : returnEmployeeDetail(detail)
    deactivate Service
    Controller --> UI : returnResponse(detail)
    deactivate Controller
    UI --> QTV : displayEmployeeDetailModal(detail)

    == 3. Quyết định phê duyệt hoặc từ chối ==
    alt Phê duyệt hồ sơ nhân viên
        QTV -> UI : clickApproveEmployee()
        UI -> Controller : approveEmployee(approvalId)
        activate Controller
        Controller -> Service : approveEmployee(approvalId, adminId)
        activate Service

        Service -> DB : executeQuery() (UPDATE partner_employees SET status = 'ACTIVE', approved_at = NOW())
        activate DB
        DB --> Service : returnResult
        deactivate DB

        Service -> LogService : logAdminAction(adminId, 'APPROVE_EMPLOYEE', approvalId)
        activate LogService
        LogService -> DB : executeQuery() (INSERT INTO system_logs)
        activate DB
        DB --> LogService : returnResult
        deactivate DB
        LogService --> Service : returnLogged
        deactivate LogService

        Service --> Controller : returnApproveSuccess()
        Controller --> UI : returnResponse({ message: "Phê duyệt nhân viên thành công" })
        deactivate Service
        deactivate Controller
        UI --> QTV : showSuccessToast("Phê duyệt hồ sơ nhân viên đối tác thành công")

    else A2 / A3: Từ chối hồ sơ nhân viên (hoặc thiếu thông tin)
        QTV -> UI : clickRejectEmployee()
        UI --> QTV : displayRejectReasonModal()
        QTV -> UI : inputRejectReasonAndConfirm(reason)
        UI -> Controller : rejectEmployee(approvalId, reason)
        activate Controller
        Controller -> Service : rejectEmployee(approvalId, reason, adminId)
        activate Service

        Service -> DB : executeQuery() (UPDATE partner_employees SET status = 'REJECTED', reject_reason = $1)
        activate DB
        DB --> Service : returnResult
        deactivate DB

        Service -> LogService : logAdminAction(adminId, 'REJECT_EMPLOYEE', approvalId)
        activate LogService
        LogService -> DB : executeQuery() (INSERT INTO system_logs)
        activate DB
        DB --> LogService : returnResult
        deactivate DB
        LogService --> Service : returnLogged
        deactivate LogService

        Service --> Controller : returnRejectSuccess()
        Controller --> UI : returnResponse({ message: "Từ chối hồ sơ nhân viên thành công" })
        deactivate Service
        deactivate Controller
        UI --> QTV : showToastMessage("Đã từ chối hồ sơ nhân viên đối tác")
    end
end
deactivate UI

@enduml
