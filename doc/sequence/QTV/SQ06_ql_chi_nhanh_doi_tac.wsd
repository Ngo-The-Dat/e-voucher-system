@startuml
title Biểu đồ tuần tự: UC-ADM-06 - Quản lý chi nhánh đối tác

autonumber
actor "Quản trị viên" as QTV
boundary "Giao diện Chi nhánh đối tác\n(PartnerBranchesModal)" as UI
control "PartnerController" as Controller
entity "PartnerService" as Service
entity "SystemLogService" as LogService

== 1. Xem danh sách chi nhánh của đối tác ==
QTV -> UI : openPartnerBranches(partnerId)
activate UI
UI -> Controller : getPartnerBranches(partnerId)
activate Controller
Controller -> Service : getPartnerBranches(partnerId)
activate Service
Service --> Controller : return branches
deactivate Service
Controller --> UI : 200 OK ({ branches })
deactivate Controller
UI --> QTV : displayBranchList(branches)

== 2. Thao tác Thêm mới / Cập nhật / Xóa chi nhánh ==
alt Thêm mới chi nhánh
    QTV -> UI : inputBranchInfo(branchData)
    QTV -> UI : clickCreateBranch()
    UI -> Controller : createPartnerBranch(partnerId, branchData)
    activate Controller
    Controller -> Service : createPartnerBranch(partnerId, branchData, adminId)
    activate Service

    Service -> LogService : logAdminAction(adminId, 'CREATE_BRANCH', newBranch.id)
    activate LogService
    LogService --> Service : return void
    deactivate LogService

    Service --> Controller : return newBranch
    Controller --> UI : 201 Created (newBranch)
    deactivate Service
    deactivate Controller
    UI --> QTV : showSuccessToast("Thêm chi nhánh thành công")

else Cập nhật chi nhánh
    QTV -> UI : editBranchInfo(branchId, updatedData)
    QTV -> UI : clickSaveBranch()
    UI -> Controller : updatePartnerBranch(partnerId, branchId, updatedData)
    activate Controller
    Controller -> Service : updatePartnerBranch(partnerId, branchId, updatedData, adminId)
    activate Service

    Service -> LogService : logAdminAction(adminId, 'UPDATE_BRANCH', branchId)
    activate LogService
    LogService --> Service : return void
    deactivate LogService

    Service --> Controller : return updatedBranch
    Controller --> UI : 200 OK (updatedBranch)
    deactivate Service
    deactivate Controller
    UI --> QTV : showSuccessToast("Cập nhật chi nhánh thành công")

else Xóa / Vô hiệu hóa chi nhánh
    QTV -> UI : clickDeleteBranch(branchId)
    UI -> Controller : deletePartnerBranch(partnerId, branchId)
    activate Controller
    Controller -> Service : deletePartnerBranch(partnerId, branchId, adminId)
    activate Service

    Service -> LogService : logAdminAction(adminId, 'DELETE_BRANCH', branchId)
    activate LogService
    LogService --> Service : return void
    deactivate LogService

    Service --> Controller : return { message: 'Xóa chi nhánh thành công', branch_id }
    Controller --> UI : 200 OK ({ message, branch_id })
    deactivate Service
    deactivate Controller
    UI --> QTV : showSuccessToast("Xóa chi nhánh thành công")
end
deactivate UI

@enduml
