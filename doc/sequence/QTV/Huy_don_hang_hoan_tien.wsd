@startuml
title Biểu đồ tuần tự: UC-ADM-10 - Hủy đơn hàng và hoàn tiền

autonumber
actor "Quản trị viên" as QTV
boundary "Giao diện Chi tiết đơn hàng\n(OrderDetailModal)" as UI
control "OrderController" as Controller
entity "OrderService" as Service
entity "SystemLogService" as LogService
database "Cơ sở dữ liệu\n(Database)" as DB

== 1. Kiểm tra điều kiện hủy đơn ==
QTV -> UI : openOrderDetail(orderId)
activate UI
UI -> UI : checkRefundPolicy(RB-14: status != 'CANCELLED' && vouchers != 'USED')

alt A1: Đơn hàng không đủ điều kiện hủy (Voucher đã sử dụng / Đã hủy)
    UI --> QTV : disableCancelButton("Đơn hàng không đủ điều kiện hủy do voucher đã sử dụng")
else Đơn hàng đủ điều kiện hủy
    UI --> QTV : enableCancelButton()

    == 2. Xác nhận và thực hiện hủy đơn hàng ==
    QTV -> UI : clickCancelOrderButton()
    UI --> QTV : displayCancelReasonModal()

    alt A2: Quản trị viên hủy thao tác
        QTV -> UI : clickDismissButton()
        UI --> QTV : closeCancelModal()
    else Quản trị viên xác nhận hủy đơn
        QTV -> UI : inputCancelReasonAndConfirm(reason)
        UI -> Controller : cancelOrder(orderId, reason)
        activate Controller
        Controller -> Service : cancelOrderAndRefund(orderId, reason, adminId)
        activate Service

        Service -> DB : executeQuery() (UPDATE orders SET status = 'CANCELLED', cancel_reason = $1)
        activate DB
        DB --> Service : returnResult
        deactivate DB

        Service -> DB : executeQuery() (UPDATE payments SET status = 'REFUNDED')
        activate DB
        DB --> Service : returnResult
        deactivate DB

        Service -> DB : executeQuery() (UPDATE issued_vouchers SET status = 'VOID' WHERE order_id = $1)
        activate DB
        DB --> Service : returnResult
        deactivate DB

        Service -> LogService : logAdminAction(adminId, 'CANCEL_ORDER', orderId)
        activate LogService
        LogService -> DB : executeQuery() (INSERT INTO system_logs)
        activate DB
        DB --> LogService : returnResult
        deactivate DB
        LogService --> Service : returnLogged
        deactivate LogService

        Service --> Controller : returnCancelSuccess()
        Controller --> UI : returnResponse({ message: "Hủy đơn hàng và hoàn tiền thành công" })
        deactivate Service
        deactivate Controller
        UI --> QTV : showSuccessToast("Hủy đơn hàng và ghi nhận hoàn tiền mô phỏng thành công")
    end
end
deactivate UI

@enduml
