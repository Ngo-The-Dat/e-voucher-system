@startuml
title Biểu đồ tuần tự: UC-ADM-01 - Tra cứu người dùng

autonumber
actor "Quản trị viên" as QTV
boundary "Giao diện Quản lý người dùng\n(UsersPage)" as UI
control "UserController" as Controller
entity "UserService" as Service

== 1. Tải danh sách người dùng mặc định ==
QTV -> UI : openUsersPage()
activate UI
UI -> Controller : getUsers(params)
activate Controller
Controller -> Service : getUsers(filter)
activate Service
Service --> Controller : return { users, pagination }
deactivate Service
Controller --> UI : 200 OK ({ users, pagination })
deactivate Controller
UI --> QTV : displayUserList()
deactivate UI

== 2. Tìm kiếm và Lọc người dùng ==
QTV -> UI : inputSearchFilter(keyword, role, status)
activate UI
QTV -> UI : clickSearchButton()
UI -> Controller : getUsers(params)
activate Controller
Controller -> Service : getUsers(filter)
activate Service
Service --> Controller : return { users, pagination }
deactivate Service
Controller --> UI : 200 OK ({ users, pagination })
deactivate Controller

alt [users.length == 0] (Không tìm thấy người dùng phù hợp)
    UI --> QTV : showNotFoundMessage("Không tìm thấy người dùng phù hợp")
else [users.length > 0] (Tìm thấy người dùng phù hợp)
    UI --> QTV : displayUserList(users)

    == 3. Xem chi tiết người dùng ==
    QTV -> UI : selectUserDetail(userId)
    UI -> Controller : getUser(userId)
    activate Controller
    Controller -> Service : getUserById(userId)
    activate Service
    Service --> Controller : return userDetail
    deactivate Service
    Controller --> UI : 200 OK (userDetail)
    deactivate Controller
    UI --> QTV : displayUserDetailModal(profile, role, status)
end
deactivate UI

@enduml
