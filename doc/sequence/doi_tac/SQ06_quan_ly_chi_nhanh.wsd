@startuml
title Biểu đồ tuần tự: SQ06 - Quản lý chi nhánh cửa hàng

autonumber
skinparam dpi 180
skinparam maxMessageSize 120
skinparam BoxPadding 10
skinparam ParticipantPadding 10

actor "Đối tác" as DT
boundary ":BranchManagementPage" as UI
control ":BranchController" as Ctrl
entity ":BranchService" as Svc

== 1. Lấy danh sách chi nhánh ==
DT -> UI: openBranchesPage()
UI -> Ctrl: getBranches()
activate Ctrl
Ctrl -> Svc: getBranches(partnerId)
activate Svc
Svc --> Ctrl: return branches
deactivate Svc
Ctrl --> UI: 200 OK (branches)
deactivate Ctrl
UI --> DT: displayBranchesTable(branches)

== 2. Tạo chi nhánh mới ==
DT -> UI: submitCreateBranch(branchData)
UI -> Ctrl: createBranch(branchData)
activate Ctrl
Ctrl -> Svc: createBranch(partnerId, branchData)
activate Svc
Svc --> Ctrl: return branch
deactivate Svc
Ctrl --> UI: 201 Created ({\n  message: "Tạo chi nhánh thành công.",\n  branch\n})
deactivate Ctrl
UI --> DT: showSuccessToast("Tạo chi nhánh thành công.")

== 3. Chỉnh sửa chi nhánh ==
DT -> UI: submitUpdateBranch(branchId, updatedData)
UI -> Ctrl: updateBranch(branchId, updatedData)
activate Ctrl
Ctrl -> Svc: updateBranch(branchId, partnerId, updatedData)
activate Svc
Svc --> Ctrl: return branch
deactivate Svc
Ctrl --> UI: 200 OK ({\n  message: "Cập nhật chi nhánh thành công.",\n  branch\n})
deactivate Ctrl
UI --> DT: showSuccessToast("Cập nhật chi nhánh thành công.")

== 4. Vô hiệu hóa (Xóa mềm) chi nhánh ==
DT -> UI: confirmDeleteBranch(branchId)
UI -> Ctrl: deleteBranch(branchId)
activate Ctrl
Ctrl -> Svc: deleteBranch(branchId, partnerId)
activate Svc
Svc --> Ctrl: return void
deactivate Svc
Ctrl --> UI: 200 OK ({\n  message: "Chi nhánh đã được vô hiệu hóa."\n})
deactivate Ctrl
UI --> DT: showSuccessToast("Chi nhánh đã được vô hiệu hóa.")

@enduml
