@startuml
title Biểu đồ tuần tự: SQ07 - Quản lý nhân viên chi nhánh đối tác

autonumber
skinparam dpi 180
skinparam maxMessageSize 120
skinparam BoxPadding 10
skinparam ParticipantPadding 10

actor "Đối tác" as DT
boundary ":EmployeeManagementPage" as UI
control ":PartnerEmployeeMgmtController" as Ctrl
entity ":PartnerEmployeeMgmtService" as Svc

== 1. Lấy danh sách nhân viên chi nhánh ==
DT -> UI: openEmployeeListPage()
UI -> Ctrl: getEmployees()
activate Ctrl
Ctrl -> Svc: getEmployees(partnerId)
activate Svc
Svc --> Ctrl: return employees
deactivate Svc
Ctrl --> UI: 200 OK (employees)
deactivate Ctrl
UI --> DT: displayEmployeesTable(employees)

== 2. Thêm mới nhân viên chi nhánh ==
DT -> UI: submitCreateEmployee(employeeData)
UI -> Ctrl: createEmployee(employeeData)
activate Ctrl
Ctrl -> Svc: createEmployee(partnerId, employeeData)
activate Svc
Svc --> Ctrl: return newEmployee
deactivate Svc
Ctrl --> UI: 201 Created (newEmployee)
deactivate Ctrl
UI --> DT: showSuccessToast(\n  "Thêm nhân viên thành công,\n  đang chờ Admin duyệt."\n)

note over DT, Svc
  Nhân viên mới được tạo ở trạng thái PENDING_APPROVAL.
  Quản trị viên xét duyệt tài khoản theo quy trình riêng (UC-ADM-14).
end note

== 3. Cập nhật thông tin hoặc Điều chuyển chi nhánh ==
DT -> UI: submitUpdateEmployee(employeeId, updateData)
UI -> Ctrl: updateEmployee(employeeId, updateData)
activate Ctrl
Ctrl -> Svc: updateEmployee(partnerId, employeeId, updateData)
activate Svc
Svc --> Ctrl: return { success: true, message: "Cập nhật nhân viên thành công." }
deactivate Svc
Ctrl --> UI: 200 OK ({\n  success: true,\n  message: "Cập nhật nhân viên thành công."\n})
deactivate Ctrl
UI --> DT: showSuccessToast("Cập nhật thông tin nhân viên thành công.")

@enduml
