@startuml
title Biểu đồ tuần tự: SQ09 - Quản lý bộ sưu tập ảnh Voucher

autonumber
skinparam dpi 180
skinparam maxMessageSize 120
skinparam BoxPadding 10
skinparam ParticipantPadding 10

actor "Đối tác" as DT
boundary ":VoucherImageGallery" as UI
control ":VoucherImageController" as Ctrl
entity ":VoucherImageService" as Svc
entity ":R2Service" as Storage

== 1. Tải lên hình ảnh mới cho Voucher ==
DT -> UI: selectImageFile(file, is_primary)
UI -> Ctrl: uploadImage(programId, file, is_primary)
activate Ctrl
Ctrl -> Svc: addVoucherImage(programId, partnerId, file, is_primary)
activate Svc
Svc -> Storage: uploadVoucherImage(programId, file)
activate Storage
Storage --> Svc: return imageUrl
deactivate Storage
Svc --> Ctrl: return image
deactivate Svc
Ctrl --> UI: 201 Created ({\n  message: "Upload ảnh thành công.",\n  image\n})
deactivate Ctrl
UI --> DT: appendImageCard(image)

== 2. Thiết lập ảnh đại diện chính (Primary Image) ==
DT -> UI: clickSetPrimary(imageId)
UI -> Ctrl: setPrimary(programId, imageId)
activate Ctrl
Ctrl -> Svc: setPrimaryImage(programId, imageId, partnerId)
activate Svc
Svc -> Svc: getVoucherImages(programId)
Svc --> Ctrl: return images
deactivate Svc
Ctrl --> UI: 200 OK ({\n  message: "Đã cập nhật ảnh chính.",\n  images\n})
deactivate Ctrl
UI --> DT: updatePrimaryBadge(imageId)

== 3. Thay đổi thứ tự sắp xếp ảnh (Reorder) ==
DT -> UI: submitReorder(imageIds)
UI -> Ctrl: reorder(programId, imageIds)
activate Ctrl
Ctrl -> Svc: reorderVoucherImages(programId, partnerId, imageIds)
activate Svc
Svc -> Svc: getVoucherImages(programId)
Svc --> Ctrl: return images
deactivate Svc
Ctrl --> UI: 200 OK ({\n  message: "Đã cập nhật thứ tự ảnh.",\n  images\n})
deactivate Ctrl
UI --> DT: renderReorderedGallery(images)

== 4. Xóa ảnh khỏi Voucher ==
DT -> UI: clickDelete(imageId)
UI -> Ctrl: remove(programId, imageId)
activate Ctrl
Ctrl -> Svc: deleteVoucherImage(programId, imageId, partnerId)
activate Svc
Svc -> Storage: deleteR2Image(imageUrl)
activate Storage
Storage --> Svc: return void
deactivate Storage
Svc -> Svc: getVoucherImages(programId)
Svc --> Ctrl: return images
deactivate Svc
Ctrl --> UI: 200 OK ({\n  message: "Đã xóa ảnh voucher.",\n  images\n})
deactivate Ctrl
UI --> DT: removeImageCard(imageId)

@enduml
