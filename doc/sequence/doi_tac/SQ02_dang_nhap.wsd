@startuml
title SQ02 - Đăng nhập hệ thống (Đối tác & Nhân viên đối tác)

autonumber
skinparam BoxPadding 10
skinparam ParticipantPadding 10

actor "Người dùng\n(Đối tác / Nhân viên)" as User
boundary ":LoginPage" as UI
control ":PartnerAuthController" as Ctrl
entity ":PartnerAuthService" as AuthSvc

User -> UI: submitLoginForm(email, password)
UI -> Ctrl: login({ email, password })
activate Ctrl
Ctrl -> AuthSvc: login({ email, password })
activate AuthSvc

alt Người dùng không tồn tại hoặc sai mật khẩu
    AuthSvc --> Ctrl: throw HttpError(401, "Email hoặc mật khẩu không đúng.")
    Ctrl --> UI: return error(401, "Email hoặc mật khẩu không đúng.")
    UI --> User: showErrorMessage("Email hoặc mật khẩu không đúng.")
else role == 'PARTNER_EMPLOYEE' && (!user.branch_id || user.branch_status != 'ACTIVE')
    AuthSvc --> Ctrl: throw HttpError(403, "Chi nhánh được phân công đã bị vô hiệu hóa.")
    Ctrl --> UI: return error(403, message)
    UI --> User: showErrorMessage(message)
else user.approval_status == 'PENDING' || user.approval_status == 'REJECTED'
    AuthSvc --> Ctrl: throw HttpError(403, "Tài khoản đang chờ được Admin phê duyệt.")
    Ctrl --> UI: return error(403, message)
    UI --> User: showErrorMessage(message)
else user.status == 'LOCKED' || user.activity_status == 'LOCKED'
    AuthSvc --> Ctrl: throw HttpError(403, "Tài khoản đã bị khóa. Vui lòng liên hệ hỗ trợ.")
    Ctrl --> UI: return error(403, message)
    UI --> User: showErrorMessage(message)
else Thông tin và trạng thái hợp lệ
    AuthSvc --> Ctrl: return { token, user }
    deactivate AuthSvc
    Ctrl --> UI: return { token, user }
    deactivate Ctrl
    UI -> UI: saveToken(token)
    UI --> User: redirectToPortal(user.role)
end

@enduml
