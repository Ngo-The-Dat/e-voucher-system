@startuml
title Biểu đồ tuần tự: SQ12 - Xác nhận sử dụng Voucher tại chi nhánh

autonumber
skinparam dpi 180
skinparam maxMessageSize 120
skinparam BoxPadding 10
skinparam ParticipantPadding 10

actor "Khách hàng" as Customer
actor "Đối tác / Nhân viên" as Staff
boundary ":VoucherRedeemModal" as UI
control ":RedeemController" as Ctrl
entity ":RedeemService" as Svc

Customer -> Staff: presentVoucher(voucherCode)
Staff -> UI: clickConfirmRedeem(voucher_code, branch_id)
UI -> Ctrl: redeemVoucher({ voucher_code, branch_id })
activate Ctrl
Ctrl -> Ctrl: resolvePartnerContext(userId, role)

opt role === 'PARTNER_EMPLOYEE' && employeeBranchId !== branch_id
    Ctrl --> UI: 403 Forbidden ("Sai chi nhánh công tác")
    UI --> Staff: showErrorMessage("Sai chi nhánh công tác")
end

Ctrl -> Svc: redeemVoucher(voucherCode, branchId, partnerId)
activate Svc

alt Không tìm thấy voucher
    Svc --> Ctrl: throw HttpError(404, "Không tìm thấy voucher")
    Ctrl --> UI: 404 Not Found (message)
    UI --> Staff: showErrorMessage(message)
    Staff --> Customer: notifyRedeemFailure(message)
else Trạng thái không hợp lệ (USED / EXPIRED / CANCELLED)
    Svc --> Ctrl: throw HttpError(400, "Voucher đã dùng / hết hạn / bị hủy")
    Ctrl --> UI: 400 Bad Request (message)
    UI --> Staff: showErrorMessage(message)
    Staff --> Customer: notifyRedeemFailure(message)
else Voucher chưa đến thời gian sử dụng
    Svc --> Ctrl: throw HttpError(400, "Chưa đến thời gian áp dụng")
    Ctrl --> UI: 400 Bad Request (message)
    UI --> Staff: showErrorMessage(message)
    Staff --> Customer: notifyRedeemFailure(message)
else Voucher đã hết hạn sử dụng
    Svc --> Ctrl: throw HttpError(400, "Voucher đã hết hạn")
    Ctrl --> UI: 400 Bad Request (message)
    UI --> Staff: showErrorMessage(message)
    Staff --> Customer: notifyRedeemFailure(message)
else Chi nhánh không nằm trong danh sách áp dụng
    Svc --> Ctrl: throw HttpError(400, "Chi nhánh không áp dụng")
    Ctrl --> UI: 400 Bad Request (message)
    UI --> Staff: showErrorMessage(message)
    Staff --> Customer: notifyRedeemFailure(message)
else Đổi thành công
    Svc --> Ctrl: return {\n      issued_voucher_id, voucher_code,\n      redeemed_at, message: "Thành công"\n    }
    deactivate Svc
    Ctrl --> UI: 200 OK ({\n      issued_voucher_id,\n      redeemed_at\n    })
    deactivate Ctrl
    UI --> Staff: renderRedeemSuccessModal(redeemed_at)
    Staff -> Customer: applyDiscountAndProvideService()
end

@enduml
