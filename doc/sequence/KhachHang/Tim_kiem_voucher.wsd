@startuml
title Tìm kiếm và Lọc Voucher (BR-CUS-03)

autonumber
actor "Khách hàng" as KH
boundary "Giao diện" as UI
control "Controller" as Controller
entity "CatalogService" as Service

KH -> UI : changeSearchFilters(keyword, category, priceRange, sort)
activate UI
UI -> Controller : getVouchers(filters)
activate Controller
Controller -> Service : getPublicVouchers(filters)
activate Service
Service --> Controller : voucherList, pagination
deactivate Service
Controller --> UI : renderVouchers(voucherList, pagination)
deactivate Controller
UI --> KH : displayVouchersList()
deactivate UI
@enduml
