@startuml
title Biểu đồ tuần tự: Nhan_voucher_da_mua

autonumber
actor "Khách hàng" as KH
boundary "Giao diện Vouchers (CustomerVoucherPage)" as UI
control "VoucherController" as Controller
entity "VoucherService" as Service
database "Cơ sở dữ liệu (Database)" as DB

KH -> UI : openMyVouchersPage()
activate UI
UI -> Controller : getMyVouchers(customerId)
activate Controller
Controller -> Service : fetchPurchasedVouchers(customerId)
activate Service
Service -> DB : queryVouchers(customerId)
activate DB
DB --> Service : voucherList
deactivate DB
Service --> Controller : voucherList
deactivate Service
Controller --> UI : renderVouchers(voucherList)
deactivate Controller
UI --> KH : displayVouchers(voucherList)
deactivate UI

alt No vouchers found
    UI --> KH : showEmptyStateMessage()
else Vouchers exist
    KH -> UI : selectVoucher(voucherId)
    activate UI
    UI -> Controller : getVoucherDetails(voucherId)
    activate Controller
    Controller -> Service : getVoucherDetails(voucherId)
    activate Service
    Service -> DB : queryVoucherDetails(voucherId)
    activate DB
    DB --> Service : voucherDetails
    deactivate DB
    Service --> Controller : voucherDetails
    deactivate Service
    Controller --> UI : renderVoucherDetails(voucherDetails)
    deactivate Controller
    UI --> KH : displayVoucherDetails(voucherDetails)
    deactivate UI
end
@enduml
