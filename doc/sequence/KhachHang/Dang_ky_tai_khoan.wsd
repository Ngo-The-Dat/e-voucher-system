@startuml
title Đăng ký tài khoản (BR-CUS-01)

autonumber
actor "Khách hàng" as KH
boundary "Giao diện Đăng ký" as UI
control "AuthController" as Controller
entity "AuthService" as Service
boundary "Dịch vụ Email/SMS (Notification)" as Notification
database "Cơ sở dữ liệu (Database)" as DB

KH -> UI : submitRegister(name, emailOrPhone, password)
activate UI
UI -> Controller : registerUser(name, emailOrPhone, password)
activate Controller
Controller -> Service : processRegistration(name, emailOrPhone, password)
activate Service

Service -> DB : checkExistingUser(emailOrPhone)
activate DB
DB --> Service : userNotExists
deactivate DB

Service -> Notification : sendOTP(emailOrPhone)
activate Notification
Notification --> Service : success
deactivate Notification

Service --> Controller : requireOTPVerification
deactivate Service
Controller --> UI : showOTPInputForm()
deactivate Controller
UI --> KH : displayOTPForm()
deactivate UI

KH -> UI : submitOTP(otpCode)
activate UI
UI -> Controller : verifyOTPAndCreateUser(emailOrPhone, otpCode)
activate Controller
Controller -> Service : verifyOTPAndSave(emailOrPhone, otpCode)
activate Service
Service -> DB : insertUser(name, emailOrPhone, hashed_password)
activate DB
DB --> Service : userId
deactivate DB

Service --> Controller : success, jwtToken
deactivate Service
Controller --> UI : registerSuccess(jwtToken)
deactivate Controller
UI --> KH : showSuccessAndAutoLogin()
deactivate UI
@enduml
