@startuml
left to right direction
actor "Đối tác" as DT

rectangle "Doanh nghiệp quản lý đối tác & voucher" {
  usecase "Thiết lập và duy trì quan hệ đối tác" as BUC01
  usecase "Triển khai chương trình khuyến mãi voucher" as BUC02
  usecase "Sử dụng voucher tại điểm bán" as BUC03
  usecase "Theo dõi hiệu quả kinh doanh của đối tác" as BUC04
}

DT --> BUC01
DT --> BUC02
DT --> BUC03
DT --> BUC04
@enduml