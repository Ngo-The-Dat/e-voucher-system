@startuml title BR-CUS-08 - Đánh giá và phản hồi

|Khách hàng|
start
:Liên hệ CSKH;
:Xuất trình voucher\nhoặc hóa đơn;

|Nhân viên CSKH|
:Cấp phiếu khảo sát;

|Khách hàng|

if (Khiếu nại nghiêm trọng?) then (Có)

    :Lập đơn khiếu nại;

    |Nhân viên CSKH|
    :Tiếp nhận đơn;
    :Đóng dấu đã nhận;
    :Chuyển xử lý khẩn cấp;

else (Không)

    :Đánh giá sao;
    :Viết nhận xét;
    :Nộp phiếu;

    |Nhân viên CSKH|
    :Lưu trữ phản hồi;
    :Gửi lời cảm ơn;

endif

stop
@enduml