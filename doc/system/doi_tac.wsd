@startuml
left to right direction

actor "Đối tác" as DT
actor "Nhân viên đối tác" as NVDT

rectangle "Hệ thống quản lý đối tác & voucher" {
  usecase "Đăng ký tài khoản đối tác" as UC01
  usecase "Quản lý hồ sơ đối tác" as UC02
  usecase "Quản lý chi nhánh" as UC03
  usecase "Quản lý nhân viên đối tác" as UC04
  usecase "Quản lý hồ sơ cá nhân nhân viên" as UC05
  usecase "Tạo voucher mới" as UC06
  usecase "Quản lý voucher" as UC07
  usecase "Chỉnh sửa voucher" as UC08
  usecase "Gửi duyệt voucher" as UC09
  usecase "Kiểm tra voucher" as UC10
  usecase "Xác nhận sử dụng voucher" as UC11
  usecase "Xem báo cáo thống kê" as UC12
}

' Liên kết của Đối tác (PARTNER)
DT --> UC01
DT --> UC02
DT --> UC03
DT --> UC04
DT --> UC06
DT --> UC07
DT --> UC10
DT --> UC11
DT --> UC12

' Liên kết của Nhân viên đối tác (PARTNER_EMPLOYEE)
NVDT --> UC05
NVDT --> UC10
NVDT --> UC11

' Quan hệ giữa các Use Case Voucher
UC08 ..> UC06 : <<extend>>
UC09 ..> UC06 : <<extend>>
UC08 ..> UC09 : <<extend>>
UC08 ..> UC07 : <<extend>>
UC09 ..> UC07 : <<extend>>

' Quan hệ Kiểm tra & Đổi voucher
UC11 ..> UC10 : <<include>>

@enduml