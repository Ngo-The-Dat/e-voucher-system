PORT=8000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/e_voucher
JWT_SECRET=replace-with-a-secret
JWT_EXPIRES_IN=7d

# Gmail account used to send partner registration OTPs.
# Enable Google 2-Step Verification and use a 16-character App Password.
GMAIL_USER=your-account@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password
GMAIL_FROM_NAME=Lumina Partner

R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-r2-bucket-name
R2_PUBLIC_BASE_URL=https://pub-xxxxxxxx.r2.dev

# PayPal & Currency Exchange Configuration
PAYPAL_MODE=mock
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_API_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_RETURN_URL=http://localhost:3000/orders
PAYPAL_CANCEL_URL=http://localhost:3000/cart

PAYPAL_EXCHANGE_RATE_VND_TO_USD=25400
EXCHANGE_RATE_API_URL=https://open.er-api.com/v6/latest/USD
EXCHANGE_RATE_FETCH_TIMEOUT_MS=2000
EXCHANGE_RATE_CACHE_TTL_MS=3600000


